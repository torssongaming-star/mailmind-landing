# ── Clerk Authentication ──────────────────────────────────────────────────────
# Get these from: https://dashboard.clerk.com → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk webhook signing secret (Clerk Dashboard → Webhooks → your endpoint)
# TODO (Phase 3): Enable Clerk webhooks to sync user lifecycle events to DB
CLERK_WEBHOOK_SECRET=

# Clerk redirect URLs — do not change these unless you rename the routes
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/app
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/app
NEXT_PUBLIC_CLERK_AFTER_SIGN_OUT_URL=/

# ── Stripe Billing ────────────────────────────────────────────────────────────
# Get these from: https://dashboard.stripe.com → Developers → API keys
# Use sk_test_* / pk_test_* in development, sk_live_* / pk_live_* in production
# Restricted keys (rk_*) are also supported if they have the required permissions:
#   Customers (read/write), Checkout Sessions (write), Billing Portal (write),
#   Subscriptions (read/write), Webhooks (read)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Stripe webhook signing secret (Stripe Dashboard → Webhooks → your endpoint)
# TODO (Phase 3): Register endpoint and add to Stripe Dashboard:
#   Events to listen for:
#     - checkout.session.completed
#     - customer.subscription.updated
#     - customer.subscription.deleted
#     - invoice.payment_failed
STRIPE_WEBHOOK_SECRET=

# Stripe Price IDs — create these in Stripe Dashboard → Products
# TODO (Phase 2): Fill these in once products are created in Stripe Dashboard
STRIPE_PRICE_ID_STARTER=
STRIPE_PRICE_ID_TEAM=
STRIPE_PRICE_ID_BUSINESS=
STRIPE_PRICE_ID_ENTERPRISE=

# ── App ───────────────────────────────────────────────────────────────────────
# Production URL used for Stripe redirect URLs (no trailing slash)
NEXT_PUBLIC_APP_URL=https://mailmind.se

# ── Database ──────────────────────────────────────────────────────────────────
# Connection string from: https://console.neon.tech → your project
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# ── Resend (outbound) ─────────────────────────────────────────────────────────
# Outbound replies + demo-requests. Inbound goes via SendGrid for now.
RESEND_API_KEY=

# From-address for outbound replies. Must be on a verified domain in Resend.
MAILMIND_FROM_EMAIL=Mailmind <noreply@mailmind.se>

# Demo-request form recipients
DEMO_REQUEST_TO=
DEMO_REQUEST_FROM=

# ── Upstash Redis (distributed rate limiting) ─────────────────────────────────
# Required in production for global rate limits across all serverless instances.
# Without these, the app falls back to per-process in-memory rate limiting.
# Create a Redis database at: https://console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Webhooks & Admin ────────────────────────────────────────────────────────
# Secret for Resend inbound webhooks
RESEND_WEBHOOK_SECRET=

# Secret for the internal admin/health endpoints
ADMIN_HEALTH_SECRET=

# ── Gmail Integration ───────────────────────────────────────────────────────
# 64 hex chars (32 bytes) used for encrypting Gmail OAuth tokens in the DB
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GMAIL_ENCRYPT_KEY=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=